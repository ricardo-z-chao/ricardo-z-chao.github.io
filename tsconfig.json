{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vue/tsconfig",
  "files": ["eslint.config.ts", "stylelint.config.ts", "env.d.ts"],
  "include": [".vitepress/**/*.ts", "components/*.vue", "lib/**/*.ts"],
  "compilerOptions": {
    "types": ["node", "markdown-it"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"],
      "@vitepress/*": [".vitepress/*"],
      "@components/*": ["components/*"],
      "@lib/*": ["lib/*"]
    },
    "allowJs": true,
    /* Linting */
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
