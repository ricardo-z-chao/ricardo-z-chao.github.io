{
  "name": "ricardo-z-chao.github.io",
  "version": "1.0.0",
  "type": "module",
  "description": "个人博客",
  "author": "ricardo <ricardo.z.chao@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardo-z-chao/ricardo-z-chao.github.io.git"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vue-tsc && vitepress build",
    "docs:preview": "vitepress preview",
    "format": "prettier --write --cache .",
    "lint:ts": "eslint --cache .",
    "lint:css": "stylelint '**/*.{css,scss,sass,vue,html}' --config stylelint.config.ts --fix",
    "typecheck": "vue-tsc -p tsconfig.json && pnpm -r --parallel --if-present run typecheck",
    "prepare": "node .husky/install.js"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write --cache"
    ],
    "*.{ts,js,vue}": [
      "prettier --write --cache",
      "eslint --cache"
    ],
    "*.{css,html}": [
      "prettier --write --cache"
    ],
    "*.{css,html,vue}": [
      "stylelint --config stylelint.config.ts --fix"
    ]
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.5.0",
    "postcss": "^8.5.26",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.3",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitepress": "^1.6.3",
    "vue-tsc": "^3.2.4"
  }
}
